{
  "name": "pi-click-sidebar",
  "version": "0.1.1",
  "description": "Clickable right sidebar for Pi: project, git changes, branch actions and model context",
  "type": "module",
  "license": "MIT",
  "author": "Adelys Alberto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdelysAlberto/pi-click-sidebar.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "src",
    "themes",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/click-sidebar.ts"
    ],
    "themes": [
      "./themes/click-sidebar-cyber.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "release:patch": "node scripts/release.ts patch",
    "release:minor": "node scripts/release.ts minor",
    "release:major": "node scripts/release.ts major",
    "release:tag": "node scripts/release.ts tag"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
